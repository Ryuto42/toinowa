# ============================================================
# ブランディング（アプリ名はいつでも変更可。src/lib/shared/branding.ts のみが参照する）
# ============================================================
NEXT_PUBLIC_APP_NAME="トイノワ"
NEXT_PUBLIC_APP_SHORT_NAME="トイノワ"
NEXT_PUBLIC_APP_TAGLINE="教えるほど、わかる。"
# 生徒の内部メール合成に使うドメイン。ユーザー作成後の変更には
# scripts/rename-auth-domain.ts が必要になるので慎重に決めること。
AUTH_EMAIL_DOMAIN="toinowa.local"

# ============================================================
# AIモデル階層
#   dev        … 最安モデル（既定。通常の開発・テストはこれ）
#                 google/gemini-2.5-flash-lite -> openai/gpt-oss-120b -> z-ai/glm-5.3-flash
#   production … 高性能モデル。「本番環境でテストする」と明示したときだけ
#
# 注: orcarouter/free（無料モデル）は課金実績$0の口座では割当がほぼ無く使えない。
#     docs/qiita-article.md の6章を参照。
# ============================================================
AI_MODEL_TIER="dev"

# 1日あたりのAI費用上限(USD)。超えたら degrade() に落として escalation を起票する。
# 暴走ループでプロモクレジットが溶ける事故を構造的に防ぐための安全弁。
AI_DAILY_BUDGET_USD="1.00"
# 生徒1人あたりの1日上限（連投で学校全体の枠を使い切らせない）
AI_STUDENT_DAILY_BUDGET_USD="0.20"
ORCAROUTER_API_KEY=""
ORCAROUTER_BASE_URL="https://api.orcarouter.ai/v1"

# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# server-only。src/lib/database/admin.ts 以外での参照はCIで検出して失敗させる（sb_secret_... 形式）
SUPABASE_SECRET_KEY=""

# ============================================================
# アプリ
# ============================================================
APP_BASE_URL="http://localhost:3000"
# openssl rand -base64 32  … pg_net -> /api/internal/worker/tick の共有シークレット
WORKER_SECRET=""
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# ============================================================
# マイグレーション適用用（scripts/db-push.ts が使う。アプリ本体は使わない）
# Supabase ダッシュボード → Connect → Direct → Session pooler の接続文字列。
# パスワードに記号が含まれる場合は percent-encode すること。
# ============================================================
DATABASE_URL=""

# 用途別モデル。評価・難しいお題はまずautoの実測を取り、必要なら固定する。
AI_ECONOMY_MODEL="google/gemini-2.5-flash-lite"
AI_STANDARD_MODEL="google/gemini-2.5-flash"
AI_ADVANCED_MODEL="orcarouter/toinowa-advanced"
AI_VISION_MODEL="google/gemini-2.5-flash"
# Separate, checkpointed exam extraction; no unvalidated model fallback.
AI_EXAM_MODEL="google/gemini-2.5-flash"
# 音声入力の段。音声を受けられるのは Google 系だけなので、段は同社内で積む。
# 全滅したときはテキスト入力へ縮退する（画面側で切り替わる）。
AI_AUDIO_MODEL="google/gemini-2.5-flash"
AI_AUDIO_STANDARD_MODEL="google/gemini-flash-latest"
AI_AUDIO_ADVANCED_MODEL="google/gemini-2.5-flash-lite"
