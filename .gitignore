# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
.idea/

# 鍵・証明書。拡張子だけで弾く（中身の確認より先に止める）
*.pem
*.key
*.p12
*.pfx
*.jks

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the example file
!.env.example

/public/pdf.worker.min.mjs

# Local evaluation inputs, credentials and raw traces
/benchmark-data/
/.orca/

# Playwright（ガイド撮影）
/playwright-report/
/test-results/
/blob-report/

# 一時出力
/tmp/
*.local.json

# 生成物の作業ディレクトリ
/output/

# 撮影用の Chrome プロファイル（ログイン状態が入る）
/.playwright-profile/
